# The /demo page's settings (as in garminconnect-nextjs-starter, plus CLIENT_IP_HEADER below).
# Copy to .env.local and fill in.

# Encrypts the MFA cookie — and, in public mode, each visitor's token cookie. At least 32 random
# characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Mode. Leave both unset for local use (one person, tokens on disk).
# GARMIN_PUBLIC=1   # shared deployment: visitors see demo data, or sign in with their own account;
#                   # their tokens live only in their own browser (encrypted cookie).
# GARMIN_DEMO=1     # synthetic data only, sign-in disabled.

# Local mode only: where tokens are stored (garth-compatible JSON). Default: .garmin-tokens
# GARMIN_TOKEN_DIR=.garmin-tokens

# Public mode: optional contact line shown on /privacy.
# PRIVACY_CONTACT=Questions? privacy@example.com

# Public mode: the header holding the real visitor IP, read first by the sign-in rate limit.
# Behind the Cloudflare Tunnel set CLIENT_IP_HEADER=cf-connecting-ip — otherwise every visitor shares
# cloudflared's IP and the per-IP limit becomes global. Only safe when the app is reachable solely
# through the tunnel (anyone reaching it directly could forge the header). Unset: x-real-ip, then
# x-forwarded-for.
# CLIENT_IP_HEADER=cf-connecting-ip
